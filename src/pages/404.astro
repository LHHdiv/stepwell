---
import Base from "../layouts/Base.astro";
---

<Base title="404 · 页面走丢了">
  <section class="section" style="text-align:center; padding-block: var(--sp-9)">
    <p class="kicker">404</p>
    <h1 class="section-title" style="font-size: var(--fs-hero); margin: 16px 0">
      这一阶还没有修好
    </h1>
    <p class="muted" style="margin-bottom: var(--sp-6)">
      你要找的页面不存在。回书房看看别的书吧。
    </p>
    <a class="btn btn-primary" href="/">回到书房</a>
  </section>
</Base>
